const problems: string[] = [];
const chars = body.replace(/\s/g, "").length;
const kw = all.split("루테인").length - 1;
if (chars < 1500) problems.push(`본문 ${chars}자(1500자 이상)`);
if (imgs.length !== 5) problems.push(`사진 ${imgs.length}장`);
if (imgs[0] < 2 || imgs.slice(1).some((v, i) => v - imgs[i] < 3)) problems.push("사진 간격 부족");
const color = all.match(/분홍|핑크|보라|퍼플|파란|남색|pink/gi); if (color) problems.push("색깔 표현: " + [...new Set(color)].join(","));
const banned = all.match(/효능|효과|시력 ?(개선|회복|향상)|노안|백내장|황반변성|(?<!질병 |질병의 예방이나 )치료(?! 중)|예방(?!이나 치료)/g);
if (banned) problems.push("금지 표현: " + [...new Set(banned)].join(","));
const bl = (all.match(/블로거 [a-z_]{4} 님/g) ?? []).length; if (bl < 10) problems.push(`후기 소개 ${bl}명`);
for (const s of sections) if (s.type === "paragraph" && s.highlight && !s.text.includes(s.highlight)) problems.push("형광펜 문구 불일치: " + s.highlight);

console.log(`본문 ${chars}자(공백 제외) · "루테인" ${kw}회 · 사진 블록 ${imgs.join(",")} · 후기 ${bl}명 · 섹션 ${sections.length}개`);
if (problems.length) { console.error("✖ " + problems.join("\n✖ ")); process.exit(1); }

const images: Record<string, string> = {};
imgs.forEach((idx, n) => (images[String(idx)] = `photo0${n + 1}.jpg`));
fs.writeFileSync("post/post.json", JSON.stringify({ title, sections, images, headingAsQuote: true }, null, 2));
console.log("✔ post/post.json 저장");
